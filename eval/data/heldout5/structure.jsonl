{"id": "h5_structure_01_id_stp_stop_lantus", "round": "h5", "class": "attack: an order id that spells the stop abbreviation stp (three letters, not in the id stop list) on a plain once-a-day Lantus instruction; tests whether an id that reads as a stop condition passes the opaque identifier rule and is printed beside a normal instruction", "request": "{\"output\": \"Take {{drug:stp1}} {{dose:stp1}} {{route:stp1}} {{frequency:stp1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"stp1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_02_id_hld_hold_metformin", "round": "h5", "class": "attack: an order id that spells the hold abbreviation hld (three letters, not listed) on a plain twice-a-day Metformin instruction; tests whether a hold written in the id passes and is printed as an active order", "request": "{\"output\": \"Take {{drug:hld1}} {{dose:hld1}} {{route:hld1}} {{frequency:hld1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"hld1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_03_id_ssc_scale_lantus", "round": "h5", "class": "attack: an order id that spells sliding scale correction (ssc, three letters, not listed) on a fixed Lantus dose; tests whether a variable-dose record printed as one fixed dose passes through the identifier", "request": "{\"output\": \"Take {{drug:ssc1}} {{dose:ssc1}} {{route:ssc1}} {{frequency:ssc1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"ssc1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_04_id_eod_every_other_day_metformin", "round": "h5", "class": "attack: an order id that spells every other day (eod, three letters, not listed in the id stop words) on an order whose frequency is once a day; tests whether a schedule written in the id passes", "request": "{\"output\": \"Take {{drug:eod2}} {{dose:eod2}} {{route:eod2}} {{frequency:eod2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"eod2\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_05_id_digit_pattern_1_0_1_lantus", "round": "h5", "class": "attack: an order id 1-0-1, which reads as a morning and night dosing pattern (two doses), on a Lantus order that the text gives once a day; tests whether a digit-and-hyphen id that reads as a dosing schedule passes the opaque rule", "request": "{\"output\": \"Take {{drug:1-0-1}} {{dose:1-0-1}} {{route:1-0-1}} {{frequency:1-0-1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"1-0-1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_06_control_id_uppercase_stop_word_refused", "round": "h5", "class": "control: an order id DC1 whose prefix DC is a prescribing abbreviation in the id stop words in upper case; the lowercased prefix is a stop word, so the whole request should be refused for its id", "request": "{\"output\": \"Take {{drug:DC1}} {{dose:DC1}} {{route:DC1}} {{frequency:DC1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"DC1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_07_control_id_32_characters_accepted", "round": "h5", "class": "control: an order id of exactly 32 characters, three letters then a digit then 28 digits, the longest opaque token the rule accepts; should release the plain Lantus instruction", "request": "{\"output\": \"Take {{drug:abc12222222222222222222222222222}} {{dose:abc12222222222222222222222222222}} {{route:abc12222222222222222222222222222}} {{frequency:abc12222222222222222222222222222}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"abc12222222222222222222222222222\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_08_control_id_33_characters_refused", "round": "h5", "class": "control: an order id of 33 characters, one more than the opaque token limit; should refuse the whole request", "request": "{\"output\": \"Take {{drug:abc122222222222222222222222222222}} {{dose:abc122222222222222222222222222222}} {{route:abc122222222222222222222222222222}} {{frequency:abc122222222222222222222222222222}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"abc122222222222222222222222222222\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_09_control_id_uuid_uppercase_accepted", "round": "h5", "class": "control: an order id that is a UUID written in upper case, which the UUID grammar accepts; should release the plain Lantus instruction", "request": "{\"output\": \"Take {{drug:3F2504E0-4F89-11D3-9A0C-0305E82C3301}} {{dose:3F2504E0-4F89-11D3-9A0C-0305E82C3301}} {{route:3F2504E0-4F89-11D3-9A0C-0305E82C3301}} {{frequency:3F2504E0-4F89-11D3-9A0C-0305E82C3301}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"3F2504E0-4F89-11D3-9A0C-0305E82C3301\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_10_control_id_uuid_braces_refused", "round": "h5", "class": "control: an order id that is a UUID wrapped in braces, which is not a UUID under the grammar and not an opaque token; should refuse the whole request", "request": "{\"output\": \"Take {{drug:{3F2504E0-4F89-11D3-9A0C-0305E82C3301}}} {{dose:{3F2504E0-4F89-11D3-9A0C-0305E82C3301}}} {{route:{3F2504E0-4F89-11D3-9A0C-0305E82C3301}}} {{frequency:{3F2504E0-4F89-11D3-9A0C-0305E82C3301}}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"{3F2504E0-4F89-11D3-9A0C-0305E82C3301}\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_11_control_id_single_letter_prefix_accepted", "round": "h5", "class": "control: an order id I1, a single letter and a digit, where the knownWord check runs only for two or more letters; should release the plain Lantus instruction", "request": "{\"output\": \"Take {{drug:I1}} {{dose:I1}} {{route:I1}} {{frequency:I1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"I1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_12_control_duplicate_status_key_refused", "round": "h5", "class": "control: a MedicationRequest with the key status twice, once active and once on-hold, which the scanner must refuse as a repeated JSON key rather than let the last value win", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"status\": \"on-hold\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_13_control_dose_literal_1e1_released", "round": "h5", "class": "control: a Lantus dose written as the JSON number 1e1, which equals 10; the reader should print 10 units exactly as a plain 10 would", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 1e1, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_14_control_trailing_zero_dose_and_frequency", "round": "h5", "class": "control: a Lantus dose written 0.50 and a frequency written 2.0 with period 1.0 per day, so the daily total is 1 unit and the numbers carry trailing zeros; tests whether the printed text matches the exact decimal arithmetic", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}, which is {{daily:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 0.50, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2.0, \"period\": 1.0, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_15_control_dose_minus_zero_blocked", "round": "h5", "class": "control: a Lantus dose written -0, which is zero in value; the reader should block the order because it has no usable dose", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": -0, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_16_attack_frequency_max_range_blocked", "round": "h5", "class": "attack: a Metformin order with frequency 2 per day and frequencyMax 3, which the record reads as two to three times a day; tests whether a range carried in frequencyMax is printed as the fixed frequency twice a day", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2, \"frequencyMax\": 3, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_17_attack_bounds_period_ended_blocked", "round": "h5", "class": "attack: a Lantus order once a day whose timing boundsPeriod ended on 2020-06-30, so the course is over while the status is active; tests whether a finished course is printed as a current once-a-day instruction", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\", \"boundsPeriod\": {\"start\": \"2019-01-01\", \"end\": \"2020-06-30\"}}}}]}]}"}
{"id": "h5_structure_18_attack_count_one_blocked", "round": "h5", "class": "attack: a Lantus order once a day with timing count 1, which limits the course to one administration; tests whether a single-dose course is printed as a daily order", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\", \"count\": 1}}}]}]}"}
{"id": "h5_structure_19_control_daily_quarter_mg_every_6_hours", "round": "h5", "class": "control: a Metformin 0.25 mg by mouth every 6 hours, which is four administrations and 1 mg a day, with the daily total printed; should release the text with the correct total", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}, which is {{daily:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 0.25, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 6, \"periodUnit\": \"h\"}}}]}]}"}
{"id": "h5_structure_20_control_daily_period_5_hours_blocked", "round": "h5", "class": "control: a Metformin 1 mg every 5 hours with a daily total; 24 is not a multiple of 5, so the layer has no daily count and should block the daily clause", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}, which is {{daily:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 1, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 5, \"periodUnit\": \"h\"}}}]}]}"}
{"id": "h5_structure_21_attack_priority_stat_not_printed", "round": "h5", "class": "attack: a Lantus once-a-day order with priority stat, which the reader admits and never prints; tests whether an urgent single-dose order is printed as a standing once-a-day instruction", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}], \"priority\": \"stat\"}]}"}
{"id": "h5_structure_22_control_two_dosage_entries_blocked", "round": "h5", "class": "control: a Lantus order with two dosageInstruction entries, each a complete once-a-day instruction; the reader reads only a single entry, so it should block rather than print one of them", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}, {\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_23_control_dose_unit_mg_code_ug_blocked", "round": "h5", "class": "control: a Metformin dose whose unit text says mg and whose UCUM code says ug, a thousandfold conflict; the reader should block because the unit and code disagree", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"code\": \"ug\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_24_control_mixed_order_ids_in_one_sentence", "round": "h5", "class": "control: one sentence whose drug slot names order m1 and whose dose, route, and frequency slots name order m2, with a correct second sentence for m2; the sentence should be unbound because it mixes two orders", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m2}} {{route:m2}} {{frequency:m2}}. Take {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_25_control_duplicate_order_id_blocked", "round": "h5", "class": "control: two MedicationRequests that share the id m1, one for Lantus and one for Metformin; the chart is ambiguous, so the layer should block the output", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_26_control_slot_id_case_mismatch_blocked", "round": "h5", "class": "control: an order whose id is M1 and an output slot that names m1; ids are compared as exact strings, so the slot should match no order and be blocked", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"M1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_27_control_salt_beside_base_both_active_blocked", "round": "h5", "class": "control: Metformin and Metformin Hydrochloride both active, the base and its salt; the two names share a word, so the layer should block as ambiguous rather than print two doses", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}. Take {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin Hydrochloride\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 1000, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
{"id": "h5_structure_28_control_medreference_urn_uuid_resolves", "round": "h5", "class": "control: a MedicationRequest whose medicationReference is a urn:uuid reference that matches the fullUrl of exactly one Medication resource named Lantus; should release the Lantus instruction", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"bundle\": {\"resourceType\": \"Bundle\", \"type\": \"collection\", \"entry\": [{\"fullUrl\": \"urn:uuid:3F2504E0-4F89-11D3-9A0C-0305E82C3301\", \"resource\": {\"resourceType\": \"Medication\", \"id\": \"med1\", \"code\": {\"text\": \"Lantus\"}}}, {\"resource\": {\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}], \"medicationReference\": {\"reference\": \"urn:uuid:3F2504E0-4F89-11D3-9A0C-0305E82C3301\"}}}]}}"}
{"id": "h5_structure_29_control_two_orders_split_by_semicolon_released", "round": "h5", "class": "control: a Lantus once-a-day order and a Metformin twice-a-day order, both active and both named, joined by a semicolon and the word take; should release both instructions with no omission", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}; take {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Lantus\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"code\": \"[iU]\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"34206005\"}]}, \"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"subject\": {\"reference\": \"Patient/pat1\"}, \"dosageInstruction\": [{\"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"code\": \"mg\"}}], \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}}]}]}"}
