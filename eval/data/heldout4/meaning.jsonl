{"id": "h4_meaning_01_doctor_heading_pharmacist_requester", "round": "h4", "class": "Source: a Doctor heading over two orders whose requester reference names a pharmacist. The text attributes the orders to a source the record contradicts.", "request": "{\"output\": \"Doctor:\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}]}"}
{"id": "h4_meaning_02_pharmacist_heading_doctor_requester", "round": "h4", "class": "Source: a Pharmacist heading over two orders whose requester reference names a doctor. The reverse of request 01.", "request": "{\"output\": \"Pharmacist:\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Lisinopril\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 10, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/dr-alvarez-md\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Atorvastatin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 20, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/dr-alvarez-md\"}}]}"}
{"id": "h4_meaning_03_from_doctor_past_tense_no_source", "round": "h4", "class": "Source: a past-tense sentence, These were from your doctor, over two orders that carry no requester or recorder at all.", "request": "{\"output\": \"These were from your doctor.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_04_swapped_headings_split_requesters", "round": "h4", "class": "Source: two headings (Doctor, then Nurse) over orders whose requesters name a pharmacist and a doctor, so each heading contradicts the record of its order.", "request": "{\"output\": \"Doctor:\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nNurse:\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/dr-alvarez-md\"}}]}"}
{"id": "h4_meaning_05_list_from_doctor_recorder_nurse", "round": "h4", "class": "Source: a completeness frame that adds from your doctor to the list, over orders whose recorder names a nurse.", "request": "{\"output\": \"Here is the list of your medicines from your doctor.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"recorder\": {\"reference\": \"Practitioner/nurse-brandt\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"recorder\": {\"reference\": \"Practitioner/nurse-brandt\"}}]}"}
{"id": "h4_meaning_06_will_be_for_your_care_purpose", "round": "h4", "class": "Purpose: a future-tense sentence, These will be for your care, after two plain orders. It states a purpose the orders do not state.", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\\nThese will be for your care.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_07_from_pharmacist_plain", "round": "h4", "class": "Source: a plain sentence, These are from your pharmacist, before two plain orders with no requester.", "request": "{\"output\": \"These are from your pharmacist.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_08_doctor_heading_as_needed_pharmacist", "round": "h4", "class": "Source and variable order: a Doctor heading over an as-needed order (four times a day as needed) whose requester names a pharmacist, beside a scheduled order.", "request": "{\"output\": \"Doctor:\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Acetaminophen\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 4, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 325, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}], \"asNeededBoolean\": true}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}]}"}
{"id": "h4_meaning_09_list_omits_plan_order_control", "round": "h4", "class": "Control: a list frame over one active order while a plan-intent warfarin order is left out. The reader treats plan as not an order, so the list should release as faithful.", "request": "{\"output\": \"Here is the list of your medicines.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"plan\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_10_list_omits_stopped_order_control", "round": "h4", "class": "Control: a list frame over one active order while a stopped warfarin order is left out, so the list should release as faithful.", "request": "{\"output\": \"Here is the list of your medicines.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"stopped\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_11_list_omits_active_order_control", "round": "h4", "class": "Control: a list frame over one of two active orders. The completeness rule should block it as an omitted order.", "request": "{\"output\": \"Here is the list of your medicines.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_12_no_active_order_list_control", "round": "h4", "class": "Control: a bare list frame with no instruction and every order on hold. The gate should block for having no active order.", "request": "{\"output\": \"Here is the list of your medicines.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"on-hold\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"on-hold\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_13_source_and_instruction_on_one_line", "round": "h4", "class": "Source and layout: a semicolon puts the source claim, These are from your doctor, on the same line as the first instruction, so the claim reads as covering that order.", "request": "{\"output\": \"These are from your doctor; Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}]}"}
{"id": "h4_meaning_14_same_name_two_doses_control", "round": "h4", "class": "Control: two active warfarin orders at 5 mg and 2.5 mg, each given once. The labeling rule treats this as faithful, but the name rule should block it as ambiguous.", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 2.5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_15_dash_bullet_lines", "round": "h4", "class": "Layout: each instruction is a dash bullet under no heading. The dash is a text character the gate accepts.", "request": "{\"output\": \"- Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\n- Take {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_16_same_order_twice_control", "round": "h4", "class": "Control: the same warfarin instruction given on two lines. The repeated-value rule should block it, since a patient could read it as two doses.", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_17_sig_and_dose_same_order_control", "round": "h4", "class": "Control: the same warfarin order given once as a sig and once as dose, route, and frequency. The repeated-value rule should block it.", "request": "{\"output\": \"Take {{drug:m1}} {{sig:m1}}.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_18_colon_between_drug_and_dose_control", "round": "h4", "class": "Control: a colon between the drug name and the dose. The colon ends the sentence, so the second half has no take word and should block.", "request": "{\"output\": \"Take {{drug:m1}}: {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_19_daily_only_second_line_control", "round": "h4", "class": "Control: a second line that gives only the drug and the daily total for the same warfarin order. The shape check should block it.", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m1}} {{daily:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_20_parenthesized_instruction", "round": "h4", "class": "Layout: the warfarin instruction set inside parentheses, with the period inside the parentheses, beside a plain order.", "request": "{\"output\": \"(Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.)\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_21_quoted_drug_name_frame", "round": "h4", "class": "Layout: the warfarin name placed in quotation marks, which a patient may read as a nickname or a second name.", "request": "{\"output\": \"Take \\\"{{drug:m1}}\\\" {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_22_what_are_these_for_question_frame", "round": "h4", "class": "Purpose: a question frame, What are these for, placed before two plain orders. A patient may take it to name a purpose the record does not state.", "request": "{\"output\": \"What are these for.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_23_proposal_order_referenced_control", "round": "h4", "class": "Control: a slot for a proposal-intent metformin order, which the reader treats as not an order. The gate should block the slot.", "request": "{\"output\": \"Take {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"proposal\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
{"id": "h4_meaning_24_care_team_heading_over_list", "round": "h4", "class": "Source: a Your care team heading over a list frame and one order whose requester names a doctor.", "request": "{\"output\": \"Your care team:\\nHere is the list of your medicines.\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/dr-alvarez-md\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/dr-alvarez-md\"}}]}"}
{"id": "h4_meaning_25_doctor_heading_over_twin_ingredient_orders", "round": "h4", "class": "Source and identity: a Doctor heading over two orders for one ingredient under two names (Coumadin and warfarin sodium), both requested by a pharmacist.", "request": "{\"output\": \"Doctor:\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Coumadin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"warfarin sodium\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 2.5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}], \"requester\": {\"reference\": \"Practitioner/pharmacist-kim\"}}]}"}
{"id": "h4_meaning_26_pharmacist_heading_on_hold_control", "round": "h4", "class": "Control: a Pharmacist heading over a slot for an on-hold metformin order. The gate should block the inactive slot.", "request": "{\"output\": \"Pharmacist:\\nTake {{drug:m1}} {{dose:m1}} {{route:m1}} {{frequency:m1}}.\\nTake {{drug:m2}} {{dose:m2}} {{route:m2}} {{frequency:m2}}.\", \"medicationRequests\": [{\"resourceType\": \"MedicationRequest\", \"id\": \"m1\", \"status\": \"active\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Warfarin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 1, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 5, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}, {\"resourceType\": \"MedicationRequest\", \"id\": \"m2\", \"status\": \"on-hold\", \"intent\": \"order\", \"subject\": {\"reference\": \"Patient/pat1\"}, \"medicationCodeableConcept\": {\"text\": \"Metformin\"}, \"dosageInstruction\": [{\"timing\": {\"repeat\": {\"frequency\": 2, \"period\": 1, \"periodUnit\": \"d\"}}, \"route\": {\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"26643006\"}]}, \"doseAndRate\": [{\"doseQuantity\": {\"value\": 500, \"unit\": \"mg\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mg\"}}]}]}]}"}
